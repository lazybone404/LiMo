# 静态演示站构建（npm run build:demo）
#
# 打开假后端：window.fetch 被 ./src/demo/mock.ts 接管，所有 /api/* 由浏览器内的演示数据回应。
# ⚠️ 只在使用 `--mode demo` 时生效，正式构建（npm run build）读不到这些值。
VITE_DEMO=1

# 部署子路径。GitHub Pages 项目页是 https://<user>.github.io/<repo>/ → 填 /<repo>/；
# Vercel 与本地 `vite preview` 用 /（留空即 /）。
# ⚠️ 换平台时改这里，不要改 vite.config.ts —— 那份逻辑对两条部署路径是同一条。
VITE_DEMO_BASE=/
