{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LiMo",
  "version": "0.2.0",
  "identifier": "com.limo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LiMo",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    },
    "externalBin": [
      "bin/LiMoBackend/LiMoBackend"
    ],
    "resources": {
      "bin/LiMoBackend/_internal": "_internal",
      "bin/LiMoBackend/ffmpeg": "ffmpeg"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
